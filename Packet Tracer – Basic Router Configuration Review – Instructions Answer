  .qc-ad .qc-adchoices-link.bottom-right { float: right; right: 0px; bottom: 0px; border-radius: 8px 0px 0px; }
  .qc-ad .qc-adchoices-link.top-left { float: left; left: 0px; top: 0px; border-radius: 0px 0px 8px; }
  .qc-ad .qc-adchoices-link.bottom-left { float: left; left: 0px; bottom: 0px; border-radius: 0px 8px 0px 0px; }
