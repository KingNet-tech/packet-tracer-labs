.qc-ad .qc-adchoices.bottom-right { float: right; right: 0px; bottom: 0px; border-radius: 8px 0px 0px; box-shadow: rgba(0, 0, 0, 0.4) -1px -1px 2px; }

.qc-ad .qc-adchoices.top-left { float: left; left: 0px; top: 0px; border-radius: 0px 0px 8px; box-shadow: rgba(0, 0, 0, 0.4) 1px 1px 2px; }

.qc-ad .qc-adchoices.bottom-left { float: left; left: 0px; bottom: 0px; border-radius: 0px 8px 0px 0px; box-shadow: rgba(0, 0, 0, 0.4) 1px -1px 2px; }

.qc-ad .qc-adchoices:hover { width: 76px; }

.qc-ad .qc-adchoices .qc-adchoices-text { border: 0px; padding: 0px; margin: 2px 0px 3px 5px; float: left; line-height: 11px; display: none; }

.qc-ad .qc-adchoices .qc-adchoices-icon { padding: 0px; border: 0px; margin: 1px 2px 4px 0px; width: 13px; height: 13.7px; float: right; }

.qc-ad .qc-adchoices:hover .qc-adchoices-text { display: inline; }

