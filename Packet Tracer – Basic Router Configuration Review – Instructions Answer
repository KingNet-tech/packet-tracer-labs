#navigation.secondary-navigation a { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 14px; color: rgb(255, 255, 255); }

.latestPost .title a { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 24px; color: rgb(43, 43, 43); line-height: normal; }

.single-title { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 26px; color: rgb(51, 51, 51); line-height: normal; margin-top: 0px; }

body { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 17px; color: rgb(34, 34, 34); line-height: 26px; }

.sidebar .widget h3 { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 20px; color: rgb(206, 0, 68); }

.sidebar .widget, .sidebar .widget li { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 15px; color: rgb(51, 51, 51); }

#site-footer, .footer-widgets { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 16px; color: rgb(51, 51, 51); }

.footer-widgets h3 { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 18px; color: rgb(34, 34, 34); }

.post-single-content h1 { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 28px; color: rgb(196, 41, 82); border-bottom: 1px dashed rgb(207, 202, 202); margin-bottom: 4px; margin-top: 30px; }

.single_post h2 { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 25px; color: rgb(80, 49, 123); border-bottom: 1px dashed rgb(207, 202, 202); margin-bottom: 14px; margin-top: 20px; }

.single_post h3 { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 23px; color: rgb(30, 115, 190); border-bottom: 1px dashed rgb(207, 202, 202); margin-bottom: 14px; margin-top: 20px; }

h4 { font-family: Helvetica, Arial, sans-serif; font-weight: 700; font-size: 21px; color: rgb(0, 145, 116); }

h5 { font-family: Helvetica, Arial, sans-serif; font-weight: 700; font-size: 19px; color: rgb(43, 43, 43); }

h6 { font-family: Helvetica, Arial, sans-serif; font-weight: normal; font-size: 16px; color: rgb(34, 34, 34); }
