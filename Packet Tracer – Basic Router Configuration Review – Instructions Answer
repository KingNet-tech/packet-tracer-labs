@charset "utf-8";

div { -webkit-tap-highlight-color: rgba(0, 0, 0, 0); user-select: none; }

lima-video { display: flex; height: 100%; width: 100%; }

span, svg, video { vertical-align: middle; }

video { object-fit: cover; }

video, .video-player { display: flex; flex: 1 1 0%; height: 100%; width: 100%; }

.branding-row1, .branding-row2 { align-items: center; text-align: center; }

.thumb-overlay { flex-direction: column; }

.creative, .video-container { display: flex; }

.controls-overlay, .end-card-overlay, .thumb-overlay, .image-blurrer, .video-blurrer { align-items: center; display: flex; height: 100%; justify-content: center; left: 0px; position: absolute; top: 0px; width: 100%; }

.creative { background-color: rgb(255, 255, 255); box-sizing: border-box; font-family: Roboto, sans-serif; height: 100%; overflow: hidden; }

.creative:not(.interstitial) { border: 1px solid rgb(204, 204, 204); }

.end-card .controls-overlay { z-index: -1; }

.end-card .end-card-overlay { z-index: 3; }

.end-card .image-blurrer, .end-card .video-blurrer { z-index: 1; }

.end-card .thumb-overlay { z-index: 2; }

.end-card .thumb-overlay > .start-icon { visibility: hidden; }

.end-card .rewardedAdUiBottomBar { visibility: hidden; }

.end-card .video-container { z-index: 2; }

.creative:not(.end-card) .branding-row1, .creative:not(.end-card) .branding-row2 { z-index: 2; }

.custom-close-container { filter: drop-shadow(rgba(0, 0, 0, 0.2) 0px 1px 5px); height: 24px; position: absolute; right: 12px; top: 12px; width: 24px; z-index: 4; }

.custom-close-container > .custom-close-countdown-text { font-size: 16px; color: rgb(255, 255, 255); width: 24px; height: 24px; position: absolute; font-family: Roboto, Helvetica, Arial, sans-serif; z-index: 5; text-align: center; line-height: 24px; }

.custom-close-container > .custom-close-background { width: 24px; height: 24px; background-color: rgb(60, 64, 67); border-radius: 50%; z-index: 4; position: absolute; box-shadow: rgba(0, 0, 0, 0.12) 0px 2px 4px; }

.custom-close-container > .custom-close-icon { display: none; color: rgb(255, 255, 255); width: 24px; height: 24px; position: absolute; z-index: 5; text-align: center; }

.custom-close-container.show-close-icon .custom-close-icon { display: block; }

.description { color: rgba(0, 0, 0, 0.64); font-size: 12px; line-height: 1.5; max-height: 3em; -webkit-line-clamp: 2; }

.description, .headline { display: -webkit-box; overflow: hidden; text-overflow: ellipsis; -webkit-box-orient: vertical; }

.end-card-button { padding: 16px; font-size: 12px; font-weight: bold; text-align: center; }

.clickable { cursor: pointer; }

.end-card-controls { max-width: 65%; }

.end-card-controls-container { display: flex; justify-content: center; width: 100%; }

.end-card-overlay { background-color: rgba(0, 0, 0, 0.72); color: rgb(255, 255, 255); display: flex; flex-flow: column-reverse wrap; font-size: 16px; font-weight: 500; }

.end-card-overlay, .image-blurrer, .thumb-overlay { z-index: -1; }

.hidden { display: none; }

.full:not(.assetless) :not(.end-card-branding) > .branding-row1 { background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0)); padding: 16px 12px; }

.full:not(.assetless) :not(.end-card-branding) > .branding-row1 .headline { margin-bottom: 4px; }

.full:not(.assetless) :not(.end-card-branding) > .branding-row1.branding-bar-padding { padding: 16px 56px 16px 12px; }

.full:not(.assetless) :not(.end-card-branding) > .branding-row1 .logo-image { max-height: 40px; max-width: 40px; }

