@charset "utf-8";

.message_box { margin: 15px 0px; padding: 1em; }

.message_box p { margin-bottom: 0px; }

pre { overflow: auto; padding: 15px; margin: 15px 0px; position: relative; background: rgb(119, 119, 119); font-family: monospace; color: rgb(255, 255, 255); box-sizing: border-box; }

.note { background: rgb(255, 243, 205); color: rgb(133, 100, 4); }

.announce { background: rgb(208, 230, 240); color: rgb(0, 64, 133); }

.success { border: 1px solid rgb(222, 241, 191); background: rgb(212, 237, 218); color: rgb(21, 87, 36); }

.warning { border: 1px solid rgb(255, 219, 219); background: rgb(248, 215, 218); color: rgb(114, 28, 36); }

.buttons { font-size: 12px; text-decoration: none; border-radius: 5px; margin: 0px 15px 15px 0px; padding: 12px 10px; overflow: hidden; display: inline-block; width: auto; }

.buttons span { float: none; overflow: hidden; }

a.buttons { text-decoration: none; padding: 10px 20px; border-radius: 3px; border: 1px solid rgba(0, 0, 0, 0.1); text-transform: uppercase; font-weight: bold; color: rgb(255, 255, 255) !important; }

a.buttons.left { margin-right: 15px; margin-bottom: 15px; float: left; }

a.buttons.right { margin-left: 15px; margin-bottom: 15px; margin-right: 0px; float: right; }

div.button-center { width: 100%; text-align: center; }

a.buttons.center { clear: both; display: inline-block; float: none; width: auto; }

a.btn_white { color: rgb(79, 79, 79) !important; }

.btn_brown { background-color: rgb(197, 112, 63); color: white; }

.btn_brown:hover { background-color: rgb(209, 181, 147); color: white !important; }

.btn_blue { background-color: rgb(165, 184, 218); color: white; }

.btn_blue:hover { background-color: rgb(155, 173, 204); color: white !important; }

.btn_green { background-color: rgb(108, 178, 76); color: white; }

.btn_green:hover { background-color: rgb(95, 157, 67); color: white !important; }

.btn_yellow { background-color: rgb(255, 218, 107); color: rgb(255, 255, 255); }

.btn_yellow:hover { background-color: rgb(255, 211, 81); color: rgb(255, 255, 255) !important; }

.btn_red { background-color: rgb(232, 48, 48); color: white; }

.btn_red:hover { background-color: rgb(230, 49, 49); color: white !important; }

.btn_white { background-color: rgb(247, 247, 247); color: rgb(79, 79, 79); }

.btn_white:hover { background-color: rgb(244, 244, 244); color: rgb(79, 79, 79) !important; }

.btn_white:active { border: 1px solid rgb(193, 193, 193); box-shadow: rgb(193, 193, 193) 0px 0px 8px 2px inset; }

.textwidget .youtube-video, .textwidget .vimeo-video, .textwidget .googlemaps { margin: 0px; }

.youtube-video, .vimeo-video { margin: 10px 0px; width: 100%; }

.googlemaps { margin: 5px 15px 10px 0px; }

.one_half { width: 48%; }

.one_third { width: 30.66%; }

.two_third { width: 65.33%; }

.one_fourth { width: 22%; }

.three_fourth { width: 74%; }

.one_fifth { width: 16.8%; }

.two_fifth { width: 37.6%; }

.three_fifth { width: 58.4%; }

.four_fifth { width: 67.2%; }

.one_sixth { width: 13.33%; }

